generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum BrandSlug {
  apple
  xiaomi
  samsung
}

enum DeviceCategory {
  PHONE
  TABLET
  LAPTOP
  WATCH
  EARBUDS
}

/// What kind of chip this is — mobile SoCs, laptop SoCs, wearable SoCs and
/// dedicated audio chips (AirPods' H-series, Galaxy Buds' chips) are not
/// comparable to each other and are kept in separate lanes in the UI.
enum ChipsetKind {
  MOBILE_SOC
  LAPTOP_SOC
  WEARABLE_SOC
  AUDIO_CHIP
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  jobTitle     String?
  phone        String?
  email        String?
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  bookmarks Bookmark[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     BrandSlug @unique
  name     String
  accent   String
  chipsets Chipset[]
}

model Chipset {
  id            String      @id @default(cuid())
  slug          String      @unique
  brand         Brand       @relation(fields: [brandId], references: [id])
  brandId       String
  name          String
  series        String
  kind          ChipsetKind @default(MOBILE_SOC)
  releaseYear   Int
  processNode   String
  cpuSummary    String
  gpuSummary    String
  npuSummary    String?
  maxRam        String?
  highlight     String
  gradientFrom  String
  gradientTo    String
  sourceNote    String
  featured      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /// One or two sentences on what makes this chip stand out against its
  /// direct rivals — always tied to a named, checkable source, never a
  /// house opinion.
  competitiveEdge           String?
  competitiveEdgeSourceName String?
  competitiveEdgeSourceUrl  String?

  /// Short scannable label for the domain this chip actually leads in
  /// (e.g. "GPU ray tracing", "On-device AI", "Sustained/thermal",
  /// "Custom silicon"), derived from the same source as competitiveEdge —
  /// never a marketing buzzword picked without backing evidence.
  strengthTag String?

  devices     Device[]
  bookmarks   Bookmark[]
  specSources ChipsetSpecSource[]

  @@unique([brandId, name])
}

/// A single claim/spec excerpt about a chipset from one named outlet, so the
/// chipset detail page can show "here's what GSMArena says, here's what the
/// silicon vendor's own page says" side by side instead of one blended
/// in-house description.
model ChipsetSpecSource {
  id         String   @id @default(cuid())
  chipset    Chipset  @relation(fields: [chipsetId], references: [id], onDelete: Cascade)
  chipsetId  String
  sourceName String // e.g. "GSMArena", "Qualcomm (official)", "AnandTech"
  sourceUrl  String
  summary    String // short, verified excerpt/claim from that source
  fetchedAt  DateTime @default(now())

  @@unique([chipsetId, sourceUrl])
}

model Device {
  id          String         @id @default(cuid())
  slug        String         @unique
  chipset     Chipset        @relation(fields: [chipsetId], references: [id])
  chipsetId   String
  name        String
  category    DeviceCategory
  releaseDate DateTime
  region      String?

  imageUrl             String?
  imageWidth           Int?
  imageHeight          Int?
  imageAttributionText String?
  imageAttributionUrl  String?
  imageLicense         String?

  spec       DeviceSpec?
  benchmarks DeviceBenchmark[]

  @@unique([chipsetId, name])
}

enum BenchmarkFamily {
  GEEKBENCH_5
  GEEKBENCH_6
  ANTUTU_V9
  ANTUTU_V10
  ANTUTU_V11
  THREEDMARK_WILD_LIFE
  THREEDMARK_WILD_LIFE_EXTREME
  THREEDMARK_STEEL_NOMAD_LIGHT
  THREEDMARK_STEEL_NOMAD
}

enum BenchmarkMetric {
  SINGLE_CORE
  MULTI_CORE
  TOTAL
  CPU_SCORE
  GPU_SCORE
  MEM_SCORE
  UX_SCORE
  SCORE
  FPS
}

/// A single, individually-sourced benchmark measurement for one device.
/// Never averaged or normalized across benchmark families — each row is one
/// exact (family, metric) pair from one named source, so nothing gets mixed
/// (Geekbench 5 with 6, AnTuTu v10 with v11, etc). The compare UI only ranks
/// rows that share the same family + metric.
model DeviceBenchmark {
  id       String @id @default(cuid())
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId String

  family BenchmarkFamily
  metric BenchmarkMetric
  value  Float

  testedVariant String? // e.g. "12GB/256GB, Global"
  sourceName    String // e.g. "GSMArena", "Notebookcheck"
  sourceUrl     String
  sourceDate    String? // as reported by the source, e.g. "2025-09-20"
  researchedAt  DateTime @default(now())
  notes         String?

  @@unique([deviceId, family, metric, sourceUrl])
  @@index([deviceId, family, metric])
}

/// Full spec sheet for a device, laid out in the categories the trade is used
/// to reading. Every field is optional — a sheet fills in over time, and the
/// compare view renders a dash for anything still missing.
model DeviceSpec {
  id       String @id @default(cuid())
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId String @unique

  // NETWORK
  networkTechnology String?
  network2g         String?
  network3g         String?
  network4g         String?
  network5g         String?
  networkSpeed      String?

  // LAUNCH
  announced String?
  status    String?

  // BODY
  dimensions String?
  weight     String?
  build      String?
  sim        String?
  bodyExtra  String?

  // DISPLAY
  displayType       String?
  displaySize       String?
  displayResolution String?
  displayProtection String?

  // PLATFORM
  os      String?
  cpu     String?
  gpu     String?

  // MEMORY
  cardSlot        String?
  internalStorage String?

  // MAIN CAMERA
  mainCameraModules  String?
  mainCameraFeatures String?
  mainCameraVideo    String?

  // SELFIE CAMERA
  selfieCameraModules  String?
  selfieCameraFeatures String?
  selfieCameraVideo    String?

  // SOUND
  loudspeaker String?
  jack35mm    String?

  // COMMS
  wlan         String?
  bluetooth    String?
  positioning  String?
  nfc          String?
  infraredPort String?
  radio        String?
  usb          String?

  // FEATURES
  sensors String?

  // BATTERY
  batteryType String?
  charging    String?

  // MISC
  colors String?
  models String?
  sar    String?
  sarEu  String?
  price  String?

  /// Parsed numbers, so the compare view can rank and draw bars.
  /// priceEur is the EUR figure parsed out of the free-text `price` string —
  /// one consistent currency so the value-for-money chart can plot devices
  /// against each other. Null whenever no EUR price was published.
  priceEur        Float?
  displayInches   Float?
  refreshRateHz   Int?
  batteryMah      Int?
  chargingWatts   Int?
  mainCameraMp    Float?
  selfieCameraMp  Float?
  weightGrams     Float?
  heightMm        Float?
  widthMm         Float?
  thicknessMm     Float?

  sourceName String?
  sourceUrl  String?
  updatedAt  DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  chipset   Chipset  @relation(fields: [chipsetId], references: [id])
  chipsetId String
  createdAt DateTime @default(now())

  @@unique([userId, chipsetId])
}
