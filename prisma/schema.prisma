generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum BrandSlug {
  apple
  xiaomi
  samsung
}

enum DeviceCategory {
  PHONE
  TABLET
  LAPTOP
  WATCH
  EARBUDS
}

/// What kind of chip this is — mobile SoCs, laptop SoCs, wearable SoCs and
/// dedicated audio chips (AirPods' H-series, Galaxy Buds' chips) are not
/// comparable to each other and are kept in separate lanes in the UI.
enum ChipsetKind {
  MOBILE_SOC
  LAPTOP_SOC
  WEARABLE_SOC
  AUDIO_CHIP
}

/// The workload areas a chip can be strong in. Fixed list rather than free
/// text so chips stay comparable in the strength matrix.
enum ChipsetDomain {
  ON_DEVICE_AI
  GAMING_GPU
  RAY_TRACING
  CAMERA_ISP
  POWER_EFFICIENCY
  SUSTAINED_PERFORMANCE
  RAW_CPU
  CONNECTIVITY
}

/// How strong the sourced evidence says a chip is in a domain. There is
/// deliberately no "weak" level — absence of a row means nothing credible was
/// published, not that the chip is bad at it.
enum DomainLevel {
  LEADING
  STRONG
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  jobTitle     String?
  phone        String?
  email        String?
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  bookmarks Bookmark[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     BrandSlug @unique
  name     String
  accent   String
  chipsets Chipset[]
}

model Chipset {
  id            String      @id @default(cuid())
  slug          String      @unique
  brand         Brand       @relation(fields: [brandId], references: [id])
  brandId       String
  name          String
  series        String
  kind          ChipsetKind @default(MOBILE_SOC)
  releaseYear   Int
  processNode   String
  cpuSummary    String
  gpuSummary    String
  npuSummary    String?
  maxRam        String?
  highlight     String
  gradientFrom  String
  gradientTo    String
  sourceNote    String
  featured      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /// One or two sentences on what makes this chip stand out against its
  /// direct rivals — always tied to a named, checkable source, never a
  /// house opinion.
  competitiveEdge           String?
  competitiveEdgeSourceName String?
  competitiveEdgeSourceUrl  String?

  /// Short scannable label for the domain this chip actually leads in
  /// (e.g. "GPU ray tracing", "On-device AI", "Sustained/thermal",
  /// "Custom silicon"), derived from the same source as competitiveEdge —
  /// never a marketing buzzword picked without backing evidence.
  strengthTag String?

  devices     Device[]
  bookmarks   Bookmark[]
  specSources ChipsetSpecSource[]
  domains     ChipsetDomainStrength[]

  @@unique([brandId, name])
}

/// One sourced claim that a chipset is strong in one workload area. Kept as
/// rows rather than a list on Chipset so each claim carries its own evidence
/// and citation — the strength matrix is only ever drawn from these.
model ChipsetDomainStrength {
  id        String  @id @default(cuid())
  chipset   Chipset @relation(fields: [chipsetId], references: [id], onDelete: Cascade)
  chipsetId String

  domain ChipsetDomain
  level  DomainLevel

  /// What the source actually says, in one line — the reason this row exists.
  evidence   String
  sourceName String
  sourceUrl  String

  @@unique([chipsetId, domain])
  @@index([domain, level])
}

/// A single claim/spec excerpt about a chipset from one named outlet, so the
/// chipset detail page can show "here's what GSMArena says, here's what the
/// silicon vendor's own page says" side by side instead of one blended
/// in-house description.
model ChipsetSpecSource {
  id         String   @id @default(cuid())
  chipset    Chipset  @relation(fields: [chipsetId], references: [id], onDelete: Cascade)
  chipsetId  String
  sourceName String // e.g. "GSMArena", "Qualcomm (official)", "AnandTech"
  sourceUrl  String
  summary    String // short, verified excerpt/claim from that source
  fetchedAt  DateTime @default(now())

  @@unique([chipsetId, sourceUrl])
}

model Device {
  id          String         @id @default(cuid())
  slug        String         @unique
  chipset     Chipset        @relation(fields: [chipsetId], references: [id])
  chipsetId   String
  name        String
  category    DeviceCategory
  releaseDate DateTime
  region      String?

  imageUrl             String?
  imageWidth           Int?
  imageHeight          Int?
  imageAttributionText String?
  imageAttributionUrl  String?
  imageLicense         String?

  spec       DeviceSpec?
  benchmarks DeviceBenchmark[]
  traded     TradedProduct[]

  @@unique([chipsetId, name])
}

enum BenchmarkFamily {
  GEEKBENCH_5
  GEEKBENCH_6
  ANTUTU_V9
  ANTUTU_V10
  ANTUTU_V11
  THREEDMARK_WILD_LIFE
  THREEDMARK_WILD_LIFE_EXTREME
  THREEDMARK_STEEL_NOMAD_LIGHT
  THREEDMARK_STEEL_NOMAD
}

enum BenchmarkMetric {
  SINGLE_CORE
  MULTI_CORE
  TOTAL
  CPU_SCORE
  GPU_SCORE
  MEM_SCORE
  UX_SCORE
  SCORE
  FPS
}

/// A single, individually-sourced benchmark measurement for one device.
/// Never averaged or normalized across benchmark families — each row is one
/// exact (family, metric) pair from one named source, so nothing gets mixed
/// (Geekbench 5 with 6, AnTuTu v10 with v11, etc). The compare UI only ranks
/// rows that share the same family + metric.
model DeviceBenchmark {
  id       String @id @default(cuid())
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId String

  family BenchmarkFamily
  metric BenchmarkMetric
  value  Float

  testedVariant String? // e.g. "12GB/256GB, Global"
  sourceName    String // e.g. "GSMArena", "Notebookcheck"
  sourceUrl     String
  sourceDate    String? // as reported by the source, e.g. "2025-09-20"
  researchedAt  DateTime @default(now())
  notes         String?

  @@unique([deviceId, family, metric, sourceUrl])
  @@index([deviceId, family, metric])
}

/// Full spec sheet for a device, laid out in the categories the trade is used
/// to reading. Every field is optional — a sheet fills in over time, and the
/// compare view renders a dash for anything still missing.
model DeviceSpec {
  id       String @id @default(cuid())
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId String @unique

  // NETWORK
  networkTechnology String?
  network2g         String?
  network3g         String?
  network4g         String?
  network5g         String?
  networkSpeed      String?

  // LAUNCH
  announced String?
  status    String?

  // BODY
  dimensions String?
  weight     String?
  build      String?
  sim        String?
  bodyExtra  String?

  // DISPLAY
  displayType       String?
  displaySize       String?
  displayResolution String?
  displayProtection String?

  // PLATFORM
  os      String?
  cpu     String?
  gpu     String?

  // MEMORY
  cardSlot        String?
  internalStorage String?

  // MAIN CAMERA
  mainCameraModules  String?
  mainCameraFeatures String?
  mainCameraVideo    String?

  // SELFIE CAMERA
  selfieCameraModules  String?
  selfieCameraFeatures String?
  selfieCameraVideo    String?

  // SOUND
  loudspeaker String?
  jack35mm    String?

  // COMMS
  wlan         String?
  bluetooth    String?
  positioning  String?
  nfc          String?
  infraredPort String?
  radio        String?
  usb          String?

  // FEATURES
  sensors String?

  // BATTERY
  batteryType String?
  charging    String?

  // MISC
  colors String?
  models String?
  sar    String?
  sarEu  String?
  price  String?

  /// Parsed numbers, so the compare view can rank and draw bars.
  /// priceEur is the EUR figure parsed out of the free-text `price` string —
  /// one consistent currency so the value-for-money chart can plot devices
  /// against each other. Null whenever no EUR price was published.
  priceEur        Float?
  displayInches   Float?
  refreshRateHz   Int?
  batteryMah      Int?
  chargingWatts   Int?
  mainCameraMp    Float?
  selfieCameraMp  Float?
  weightGrams     Float?
  heightMm        Float?
  widthMm         Float?
  thicknessMm     Float?

  sourceName String?
  sourceUrl  String?
  updatedAt  DateTime @updatedAt
}

/// ---------------------------------------------------------------------------
/// Commercial data — the company's own trading records, kept in its own set of
/// tables so it stays separate from the public device catalog. The catalog is
/// sourced from published specs; everything below is first-party and
/// confidential, and the two are only ever joined through TradedProduct.device.
/// ---------------------------------------------------------------------------

/// A product at the grain the stock system actually trades in: model, storage
/// and colour. Finer than a catalog Device (one Device can cover many SKUs),
/// and often a model the catalog does not carry at all.
model TradedProduct {
  id   String @id @default(cuid())
  /// Case-normalised key used to merge the source file's inconsistent
  /// spellings ("Redmi A5" and "REDMI A5" are one product).
  sku  String @unique
  name String

  /// Model family with storage and colour stripped ("POCO C71"), for rolling
  /// variants up into one line on a chart.
  family    String
  brandSlug BrandSlug
  variant   String?
  colour    String?

  /// Optional link to the catalog, present only where the traded SKU matches a
  /// device we hold published specs for.
  device   Device? @relation(fields: [deviceId], references: [id])
  deviceId String?

  months    DemandMonth[]
  days      DemandDay[]
  forecasts DemandForecast[]

  @@index([family])
  @@index([deviceId])
}

/// Units and money moved in one calendar month, straight from the stock
/// ledger. Outward quantity is the demand signal.
model DemandMonth {
  id        String        @id @default(cuid())
  product   TradedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  month DateTime

  inwardQty    Int?
  inwardValue  Float?
  outwardQty   Int
  outwardValue Float?

  /// True when the month is only partly covered by the source (the final
  /// month of an export), so charts can mark it rather than read it as a drop.
  partialPeriod Boolean @default(false)

  sourceFile String

  @@unique([productId, month])
  @@index([month])
}

/// Daily movement, where the source files carry that grain.
model DemandDay {
  id        String        @id @default(cuid())
  product   TradedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  date DateTime

  inwardQty    Int?
  inwardValue  Float?
  outwardQty   Int
  outwardValue Float?

  sourceFile String

  @@unique([productId, date])
  @@index([date])
}

/// A forecast the company produced, kept with the method and its backtest
/// error so a reader can weigh it rather than take it as fact.
model DemandForecast {
  id        String        @id @default(cuid())
  product   TradedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  periodStart DateTime
  periodEnd   DateTime

  forecastQty   Int
  lowerBound    Int?
  upperBound    Int?
  confidence    Float?
  method        String
  backtestWape  Float?

  sourceFile String

  @@unique([productId, periodStart, periodEnd])
}

model Bookmark {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  chipset   Chipset  @relation(fields: [chipsetId], references: [id])
  chipsetId String
  createdAt DateTime @default(now())

  @@unique([userId, chipsetId])
}
